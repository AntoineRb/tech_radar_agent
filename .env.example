# Copy to .env (git-ignored) and fill in. Run with: uv run --env-file .env tech-radar-agent
# The LLM is any server speaking the OpenAI chat completions format.

# --- Local model with Ollama (https://ollama.com) ---
# Plain http is allowed for localhost only.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=

# --- Remote API (e.g. on a server) ---
# HTTPS is required. Never commit a real key: use .env locally, GitHub secrets in CI.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=provider-model-name
# LLM_API_KEY=your-key-here

# --- Optional LLM tuning ---
# Sent as "reasoning_effort" in every request. "none" turns off a model's thinking phase:
# ~0.3 s instead of ~18 s per call with qwen3.6 in Ollama. Leave empty if the server rejects it.
LLM_REASONING_EFFORT=none
# Seconds for one LLM call (default 30). A local model's first call loads it into memory (~20 s).
LLM_REQUEST_TIMEOUT=30
# Minimum seconds between the starts of two LLM requests, from 0 (default: no wait) to 300.
# For a remote API with a per-minute quota: 60 / requests per minute, plus a margin
# (e.g. 10 requests per minute -> 7). Retries are spaced too. A daily quota needs a lower
# AGENT_MAX_ARTICLES_PER_RUN instead: spacing the calls does not reduce their number.
LLM_MIN_INTERVAL_SECONDS=0

# --- Optional agent tuning (defaults shown) ---
# Only articles published (or collected, when there is no date) in the last N days are scored.
AGENT_MAX_ARTICLE_AGE_DAYS=3
# At most this many articles are scored per run, newest first: a safety cap on time and cost.
AGENT_MAX_ARTICLES_PER_RUN=100
# Articles scored at least this (0-10) get a summary. Scores depend on the model: retune when changing it.
AGENT_SUMMARY_THRESHOLD=8

# --- Optional ---
# Higher GitHub search rate limit (set automatically in GitHub Actions).
# GITHUB_TOKEN=

# --- Telegram: where the digest is sent ---
# Bot token from @BotFather (/newbot). It gives full control of the bot: keep it in .env or in
# GitHub secrets only, never in the code or in a log.
TELEGRAM_BOT_TOKEN=
# Your private chat id, a positive number. Send /start to your bot once, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates (message.chat.id). Groups and channels are refused.
TELEGRAM_CHAT_ID=
